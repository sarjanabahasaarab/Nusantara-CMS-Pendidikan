# ==============================================================================
# Nusantara Education CMS - Environment Variables Example
# Salin berkas ini menjadi '.env' dan sesuaikan nilainya dengan konfigurasi server.
# PERINGATAN: Jangan pernah mengunggah kredensial atau rahasia produksi ke repositori Git!
# ==============================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://nusantara_user:nusantara_secret_pass@localhost:5432/nusantara_education_db?schema=public"

# 2. AUTHENTICATION & SECURITY
# Secret key acak 32+ karakter untuk enkripsi token JWT / Session cookies
AUTH_SECRET="ganti-dengan-kunci-enkripsi-acak-yang-sangat-rahasia-32-karakter"

# Alamat email dan password awal untuk proses seeding pengguna super admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="AdminNusantara123!"

# 3. WEBSITE & APPLICATION URL
# URL dasar domain tempat CMS diakses publik (tanpa garis miring di akhir)
NEXT_PUBLIC_SITE_URL="https://sman-nusantara.sch.id"
NEXT_PUBLIC_SITE_NAME="SMA Negeri Nusantara Mandiri"

# 4. STORAGE PROVIDER (Penyimpanan Berkas & Media)
# Pilihan: 'local' | 'vercel-blob' | 's3' | 'r2'
STORAGE_PROVIDER="local"

# Konfigurasi Storage Eksternal (Hanya jika STORAGE_PROVIDER adalah 's3' atau 'r2')
STORAGE_BUCKET="nusantara-media-storage"
STORAGE_ENDPOINT="https://s3.ap-southeast-1.amazonaws.com"
STORAGE_ACCESS_KEY="masukkan-access-key-id"
STORAGE_SECRET_KEY="masukkan-secret-access-key"

# 5. INTEGRASI GEMINI AI & KECERDASAN PENDIDIKAN (Opsional)
GEMINI_API_KEY=""
